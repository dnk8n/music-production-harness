#!/bin/bash
# Every check that can run on Linux, in a cloud copy of the repo (REQ-PRC-06).
# The skill .claude/skills/cloud-checks says when to use it.
#
#   scripts/cloud-check            check this checkout as it is
#   scripts/cloud-check --setup    first install what's missing (apt, as root)
#
# Runs the pre-commit hooks, then every test except the macOS ones, with the
# real SuperCollider and LuaJIT: CI leaves out the tests marked `tools`, and
# this runs them too. Skips are listed but don't fail it (Demucs, for one, is
# usually missing here); scripts/mac-check on the Mac is the run that may
# skip nothing.
set -u

if [ "$(uname -s)" != "Linux" ]; then
  echo "cloud-check is for Linux; on a Mac run scripts/mac-check" >&2
  exit 2
fi

packages="supercollider-server supercollider-language luajit sox ffmpeg"
if [ "${1:-}" = "--setup" ]; then
  if [ "$(id -u)" -ne 0 ]; then
    echo "--setup installs with apt, so it needs root: sudo $0 --setup" >&2
    exit 2
  fi
  # shellcheck disable=SC2086 # the list is meant to split into words
  apt-get update -q && apt-get install -y --no-install-recommends $packages || exit 2
fi

missing=""
for tool in sclang scsynth luajit sox ffprobe uv; do
  command -v "$tool" >/dev/null || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "missing:$missing" >&2
  echo "install them with: $0 --setup (apt: $packages; uv: https://docs.astral.sh/uv/)" >&2
  exit 2
fi

# sclang is a Qt app: with no display it needs these, and as root also no
# Chromium sandbox.
export QT_QPA_PLATFORM=offscreen
export QTWEBENGINE_CHROMIUM_FLAGS=--no-sandbox
export QTWEBENGINE_DISABLE_SANDBOX=1
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-$(id -un)}"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

cd "$(dirname "$0")/.." || exit 2
failed=0
step() { # step NAME COMMAND...
  printf '\n== %s ==\n' "$1"
  shift
  "$@" || failed=1
}
step "install locked dependencies" uv sync --locked
step "format, lint, types, spec gate" uv run pre-commit run --all-files --show-diff-on-failure
step "every test but the macOS ones, real SuperCollider included" \
  uv run pytest -q -rs -m "not macos" --cov=mph
if [ "$failed" -ne 0 ]; then
  printf '\ncloud-check: FAIL\n'
else
  printf '\ncloud-check: ok\n'
fi
exit "$failed"
